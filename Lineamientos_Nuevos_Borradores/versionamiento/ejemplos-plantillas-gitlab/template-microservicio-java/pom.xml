<?xml version="1.0" encoding="UTF-8"?>
<!--
  EJEMPLO DE REFERENCIA — LIN-VER-001 Anexo F (F.2/F.3: "Microservicio independiente (Estadio 3)"
  -> `template-microservicio-java`) / LIN-DEV-JAVA-001 §14.1 ("Hexagonal / Clean — Estructura interna
  de cada Bounded Context o Microservicio", variante "un solo módulo Maven") / §14.3 ("Monolito simple
  o Microservicio Hexagonal en un solo JAR").

  A diferencia de template-backend-java-modular (reactor multi-módulo, POM padre packaging "pom"),
  este microservicio es UN SOLO módulo Maven con spring-boot-starter-parent directo — la variante
  que LIN-DEV-JAVA-001 §14.3 llama "Microservicio Hexagonal en un solo JAR", pensada para un
  microservicio acotado extraído según los 6 criterios de ARQ-R-001 (LIN-ARQ-001 §2.1). La pureza
  hexagonal (domain/ y application/ sin Spring/JPA) se hace cumplir con ArchUnit — ver
  src/test/java/.../architecture/ArquitecturaHexagonalTest.java.

  Antes de usar en un proyecto real:
  - Renombrar groupId/artifactId de "pe.gob.onp.template" / "template-microservicio-java" al
    microservicio real (convención LIN-DEV-JAVA-001 §14.2: "onp-{modulo}").
  - Renombrar el paquete "pe.gob.onp.template.defuncion" (dominio de ejemplo: verificación de
    defunción) al dominio real de negocio.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.0</version>
        <relativePath/>
    </parent>

    <groupId>pe.gob.onp.template</groupId>
    <artifactId>template-microservicio-java</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>template-microservicio-java</name>
    <description>Plantilla institucional ONP — Microservicio independiente Hexagonal (Estadio 3)</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <springdoc.version>2.8.9</springdoc.version>
        <!-- resilience4j-spring-boot3 NO forma parte del BOM spring-boot-dependencies: se fija
             versión explícita, alineada con la versión de Spring Boot 3.5.x de este POM. -->
        <resilience4j.version>2.2.0</resilience4j.version>
        <logstash.logback.encoder.version>7.4</logstash.logback.encoder.version>
        <opentelemetry.logback.appender.version>2.14.0-alpha</opentelemetry.logback.appender.version>
        <checkstyle.plugin.version>3.4.0</checkstyle.plugin.version>
        <jacoco.version>0.8.12</jacoco.version>
        <archunit.version>1.3.0</archunit.version>

        <!-- LIN-TEST-001 §5.1 (TEST-R-001), fila "Microservicio": ≥70% instrucción global;
             dominio / casos de uso: ≥85%. El gate global de JaCoCo abajo aplica el 70%; el 85%
             de domain/application se verifica por inspección de módulo, igual que en
             template-backend-java-modular (ver README "Cobertura de pruebas"). -->
        <jacoco.coverage.minimum>0.70</jacoco.coverage.minimum>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Persistencia Oracle (LIN-BD-ORA-001) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-oracle</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Cliente HTTP saliente hacia Registro Civil (RENIEC) — Apache HttpClient 5, obligatorio
             para Timeout fino (LIN-DIS-001 §6.1) junto a Resilience4j (§6.2/§6.3) — ver
             infrastructure/config/RegistroCivilClientConfig. -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
        </dependency>

        <!-- Circuit Breaker + Bulkhead OBLIGATORIOS en Microservicio (DIS-R-009, LIN-DIS-001 §6.2/§6.3) —
             a diferencia de template-backend-java-modular, donde es excepcional y requiere ADR. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>

        <!-- OpenAPI / Swagger UI (LIN-API-REST-001) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Observabilidad (LIN-OBS-001) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-logback-appender-1.0</artifactId>
            <version>${opentelemetry.logback.appender.version}</version>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash.logback.encoder.version}</version>
        </dependency>

        <!-- Pruebas -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Pruebas de arquitectura (LIN-DEV-JAVA-001 §15.5, tipo AT) — hacen cumplir en
                 compilación la pureza hexagonal de LIN-DIS-001 §2.3, no solo documentarla. -->
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>**/dto/**</exclude>
                                <exclude>**/persistence/*Entity.*</exclude>
                                <exclude>**/config/**</exclude>
                                <exclude>**/exception/**</exclude>
                                <exclude>**/*Application.*</exclude>
                            </excludes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.coverage.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Versión fijada explícitamente: spring-boot-starter-parent 3.5.0 hereda
                     maven-surefire-plugin 3.5.3, versión con una regresión real y verificada en
                     este entorno que hace que el motor JUnit5 de terceros ArchUnit
                     (archunit-junit5-engine) se descubra pero reporte "Tests run: 0" sin ningún
                     error (el mismo TestPlan ejecutado a mano con
                     org.junit.platform.launcher.core.LauncherFactory sí corre las 7 reglas). Se
                     confirmó que 3.5.4 no tiene esta regresión ejecutando la prueba homóloga de
                     `template-backend-java-modular` (mismas reglas ArchUnit, mismo repositorio
                     Maven local): con 3.5.4 reporta "Tests run: 9" correctamente. Ver README,
                     "Decisiones de diseño resueltas". -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstyle.plugin.version}</version>
                <configuration>
                    <configLocation>checkstyle-onp.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <failsOnError>true</failsOnError>
                    <consoleOutput>true</consoleOutput>
                </configuration>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
