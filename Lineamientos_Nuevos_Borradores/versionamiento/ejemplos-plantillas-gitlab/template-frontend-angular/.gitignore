# EJEMPLO DE REFERENCIA — LIN-VER-001 Anexo F
# .gitignore institucional para proyectos Angular/Node ONP

# Dependencias
node_modules/
.pnp
.pnp.js

# Build output
dist/
tmp/
out-tsc/
bazel-out/

# Testing
coverage/
.nyc_output/
/e2e/*.js
/e2e/*.js.map

# Angular cache
.angular/
.cache/

# IDE — VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IDE — IntelliJ IDEA / WebStorm
.idea/
*.iml

# Sistema operativo
.DS_Store
Thumbs.db

# Variables de entorno locales — NUNCA versionar
.env
.env.local
*.env

# Environments locales — usar environments/environment.local.ts (no versionar)
src/environments/environment.local.ts

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Kubernetes secrets locales
*-secret.yaml
*-secret.yml
