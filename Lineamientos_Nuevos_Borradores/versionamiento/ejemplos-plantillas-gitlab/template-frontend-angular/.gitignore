# .gitignore institucional para proyectos Angular/Node ONP — LIN-VER-001 Anexo F

# Dependencias
node_modules/
.pnp
.pnp.js

# Build output
dist/
tmp/
out-tsc/
bazel-out/

# Testing
coverage/
.nyc_output/

# Playwright (LIN-FE-ANG-001 sección 14.2)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Angular cache
.angular/
.cache/

# IDE — VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IDE — IntelliJ IDEA / WebStorm
.idea/
*.iml

# Sistema operativo
.DS_Store
Thumbs.db

# Variables de entorno locales — NUNCA versionar
.env
.env.local
*.env

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Kubernetes secrets locales
*-secret.yaml
*-secret.yml
