# EJEMPLO DE REFERENCIA — LIN-VER-001 Anexo F
# .gitignore institucional para proyectos Java/Maven/Spring Boot ONP

# Maven
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# IDE — IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# IDE — VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IDE — Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# Spring Boot
spring-shell.log

# Logs
*.log
logs/

# Sistema operativo
.DS_Store
Thumbs.db

# Variables de entorno locales — NUNCA versionar
.env
.env.local
*.env

# Secretos — NUNCA versionar
application-local.yml
application-local.yaml
application-local.properties

# Kubernetes secrets locales
*-secret.yaml
*-secret.yml
